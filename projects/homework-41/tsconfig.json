{
    "compilerOptions":  {
                            "target":  "ES6",
                            "module":  "ES2020",
                            "lib":  [
                                        "DOM",
                                        "ES2015"
                                    ],
                            "rootDir":  "./src",
                            "outDir":  "./dist",
                            "strict":  true,
                            "sourceMap":  true,
                            "noEmitOnError":  true,
                            "skipLibCheck":  true
                        },
    "include":  [
                    "src/**/*.ts"
                ]
}
